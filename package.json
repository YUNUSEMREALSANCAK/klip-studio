{
  "name": "klip-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Tarayıcıda çalışan, yapay zekalı, açık kaynak video editörü. Tüm AI özellikleri yerelde çalışır.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YUNUSEMREALSANCAK/klip-studio.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
